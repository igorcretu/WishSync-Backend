# Copy to .env and fill in values

# Database
POSTGRES_PASSWORD=change_me_strong_password

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_jwt_secret

# URLs
FRONTEND_URL=https://wishsync.crig.dev
APP_URL=https://api.wishsync.crig.dev

# SMTP — defaults to Mailpit (local dev, web UI at http://<pi-ip>:8025)
# To use Brevo in production:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your@email.com
#   SMTP_PASS=your_brevo_smtp_key
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WishSync <noreply@wishsync.crig.dev>
